import tkinter as tk
from tkinter import filedialog, messagebox
import pytesseract  # type: ignore
import random

def extraire_texte_depuis_image(chemin_image):
    try:
        image = Image.open(chemin_image)
        texte = pytesseract.image_to_string(image, lang='fra')
        return texte.strip()
    except Exception as e:
        return f"Erreur de lecture : {e}"

def analyser_ton(texte):
    texte = texte.lower()
    if any(mot in texte for mot in ["haha", "lol", "mdr", "drôle", "rigolo"]):
        return "drôle"
    elif any(mot in texte for mot in ["tu me manques", "cœur", "love", "belle", "beau"]):
        return "romantique"
    elif any(mot in texte for mot in ["ok", "d'accord", "hmm", "ouais"]):
        return "neutre"
    elif any(mot in texte for mot in ["non", "pas", "froid", "bof", "fatigué"]):
        return "froid"
    else:
        return "inconnu"

def generer_reponse(ton):
    reponses = {
        "drôle": [
            "Ah, j’vois que t’as de l’humour, j’aime ça 😉",
            "Tu sais comment me faire sourire toi 😏",
            "Hahaha, t’es pas mal dans ton genre 😄"
        ],
        "romantique": [
            "T’as le chic pour faire fondre les gens 😌",
            "C’est doux à lire, continue comme ça ❤️",
            "Tu joues avec les mots ou avec mon cœur là ? 😳"
        ],
        "neutre": [
            "Sobre, mais intriguant… tu caches bien ton jeu 😏",
            "Court, simple, mais j’te sens pas indifférent 😎",
            "Ok… mais je sens qu’y a un truc derrière, non ? 😌"
        ],
        "froid": [
            "Ouh, on dirait que quelqu’un a besoin d’un sourire 😅",
            "J’vais pas te lâcher si facilement 😏",
            "Même ton silence a du style 😌"
        ],
        "inconnu": [
            "Hmm intéressant… raconte-moi un peu plus 😌",
            "J’me demande bien ce que tu veux dire par là 😉",
            "J’aime les mystères, mais pas trop longtemps 😏"
        ]
    }
    return random.choice(reponses.get(ton, reponses["inconnu"]))

def enregistrer_historique(message, ton, reponse):
    with open("historique.txt", "a", encoding="utf-8") as f:
        f.write("Message détecté:\n")
        f.write(message + "\n")
        f.write(f"Ton: {ton}\n")
        f.write(f"Réponse générée: {reponse}\n")
        f.write("-" * 40 + "\n")

class App(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("💌 Assistant Séduction d’Alphonse")
        self.geometry("600x700")
        self.configure(bg="#1e1e1e")

        self.image_label = tk.Label(self, bg="#1e1e1e")
        self.image_label.pack(pady=10)

        self.btn_import = tk.Button(self, text="📸 Importer une image", command=self.import_image, bg="#ff0066", fg="white", font=("Arial", 12, "bold"))
        self.btn_import.pack(pady=5)

        self.text_zone = tk.Text(self, wrap=tk.WORD, width=60, height=10, bg="#2d2d2d", fg="white", font=("Arial", 11))
        self.text_zone.pack(pady=10)

        self.btn_analyze = tk.Button(self, text="💬 Analyser et proposer une réponse", command=self.analyser_message, bg="#ff3366", fg="white", font=("Arial", 12, "bold"))
        self.btn_analyze.pack(pady=10)

        self.reponse_label = tk.Label(self, text="", wraplength=550, bg="#1e1e1e", fg="#00ffaa", font=("Arial", 12, "italic"))
        self.reponse_label.pack(pady=20)

    def import_image(self):
        fichier = filedialog.askopenfilename(filetypes=[("Images", "*.png *.jpg *.jpeg")])
        if fichier:
            img = Image.open(fichier)
            img.thumbnail((300, 300))
            photo = ImageTk.PhotoImage(img)
            self.image_label.config(image=photo)
            self.image_label.image = photo
            self.chemin_image = fichier
            texte = extraire_texte_depuis_image(fichier)
            self.text_zone.delete("1.0", tk.END)
            self.text_zone.insert(tk.END, texte)

    def analyser_message(self):
        texte = self.text_zone.get("1.0", tk.END).strip()
        if not texte:
            messagebox.showwarning("Attention", "Aucun texte détecté.")
            return
        ton = analyser_ton(texte)
        reponse = generer_reponse(ton)
        self.reponse_label.config(text=reponse)
        enregistrer_historique(texte, ton, reponse)

if __name__ == "__main__":
    app = App()
    app.mainloop()
